{
  "name": "reading-buddy",
  "description": "A reading buddy for kids: pick a story, read it aloud, talk about it. React Router on Cloudflare Workers, with D1, R2 and passkeys.",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev --port 5320",
    "build": "react-router build",
    "start": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "db:migrate": "wrangler d1 migrations apply reading-buddy --local",
    "db:migrate:remote": "wrangler d1 migrations apply reading-buddy --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
